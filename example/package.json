{
  "name": "react-native-skia-skeleton-example",
  "version": "1.0.0",
  "main": "index",
  "scripts": {
    "setup-skia-for-web": "setup-skia-web",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "publish": "expo export -p web",
    "serve": "expo serve",
    "predeploy": "cd ./dist/_expo/static/js/web && find . -type f -empty -delete",
    "deploy": "yarn predeploy && eas deploy"
  },
  "dependencies": {
